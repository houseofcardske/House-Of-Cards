<!-- ================= 18+ CONFIRMATION DIALOG ================= -->
<dialog id="age-dialog">
  <h2>Age confirmation</h2>
  <p>Are you 18 years of age or older?</p>
  <div class="dialog-actions">
    <button type="button" class="btn" id="confirm-yes">Yes, I am 18+</button>
    <button type="button" class="btn btn-secondary" id="confirm-no">No</button>
  </div>
</dialog>

<script>
  const section = document.getElementById('adult-section');
  const games   = document.getElementById('adult-games');
  const gate    = document.getElementById('age-gate');
  const dialog  = document.getElementById('age-dialog');
  const KEY     = 'ageConfirmed';

  function unlock() {
    section.classList.remove('locked');
    games.removeAttribute('inert');
    gate.hidden = true;
  }

  // Stay unlocked for the rest of this browser session once confirmed
  try {
    if (sessionStorage.getItem(KEY) === 'yes') unlock();
  } catch (e) { /* storage unavailable: stay locked */ }

  document.getElementById('open-confirm').addEventListener('click', () => dialog.showModal());

  document.getElementById('confirm-yes').addEventListener('click', () => {
    try { sessionStorage.setItem(KEY, 'yes'); } catch (e) {}
    unlock();
    dialog.close();
  });

  document.getElementById('confirm-no').addEventListener('click', () => dialog.close());
</script>

